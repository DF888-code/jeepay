{
    "name": "project-hub/app",
    "description": "專案管理與知識紀錄平台（Project Hub）",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.1",
        "ext-intl": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-sodium": "*",
        "chillerlan/php-qrcode": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "ProjectHub\\": "app/"
        },
        "files": [
            "app/Support/helpers.php"
        ]
    },
    "config": {
